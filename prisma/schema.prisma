// ─── Branch RBAC/ABAC — Prisma Schema ────────────────────────────
// Multi-branch dynamic Role + action-based Access Control.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════
// Organization & Branch
// ═══════════════════════════════════════════════════════════════════

model Organization {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  branches  Branch[]
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("organizations")
}

model Branch {
  id                String             @id @default(uuid())
  name              String
  code              String             @unique
  location          String             @default("")
  isActive          Boolean            @default(true) @map("is_active")
  organizationId    String             @map("organization_id")
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users             User[]
  roles             Role[]
  branchPermissions BranchPermission[]
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")

  @@map("branches")
}

// ═══════════════════════════════════════════════════════════════════
// Users & Roles
// ═══════════════════════════════════════════════════════════════════

enum GlobalRole {
  SUPER_ADMIN
  BRANCH_ADMIN
  BRANCH_USER
}

model User {
  id             String        @id @default(uuid())
  name           String
  email          String        @unique
  password       String
  avatar         String?
  globalRole     GlobalRole    @default(BRANCH_USER) @map("global_role")
  organizationId String?       @map("organization_id")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  branchId       String?       @map("branch_id")
  branch         Branch?       @relation(fields: [branchId], references: [id])
  roleId         String?       @map("role_id")
  role           Role?         @relation("UserPrimaryRole", fields: [roleId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model Role {
  id                  String                   @id @default(uuid())
  name                String                   @unique
  description         String?
  isBuiltIn           Boolean                  @default(false) @map("is_built_in")
  branchId            String?                  @map("branch_id")
  branch              Branch?                  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  resourcePermissions RoleResourcePermission[]
  directUsers         User[]                   @relation("UserPrimaryRole")
  createdBy           String?                  @map("created_by")
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@map("roles")
}

// ═══════════════════════════════════════════════════════════════════
// Branch-scoped Dynamic RBAC/ABAC (resource + actions model)
// ═══════════════════════════════════════════════════════════════════
// "Attributes" are strictly CRUD-style actions on a resource
// (route/module). Super Admin assigns a Branch its allowed scope
// (BranchPermission). A Branch Admin grants Role permissions
// (RoleResourcePermission) that must be a SUBSET of that scope.

model BranchPermission {
  id       String   @id @default(uuid())
  branchId String   @map("branch_id")
  branch   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  resource String
  actions  String[] @default([])

  @@unique([branchId, resource])
  @@map("branch_permissions")
}

model RoleResourcePermission {
  id       String   @id @default(uuid())
  roleId   String   @map("role_id")
  role     Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  resource String
  actions  String[] @default([])

  @@unique([roleId, resource])
  @@map("role_resource_permissions")
}
