// ─── Branch RBAC/ABAC — Prisma Schema ────────────────────────────
// Multi-branch access control with per-user, action-based permissions.
//   - Super admin (role = SUPER_ADMIN) bypasses everything.
//   - Branch admin (role = BRANCH_ADMIN) is mapped to one branch and is
//     granted specific routes (resources) + actions by the super admin.
//   - Actions are dynamic (the `actions` table); resources are a config list.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Roles {
  SUPER_ADMIN
  BRANCH_ADMIN
  USER
}

enum Status {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

// ═══════════════════════════════════════════════════════════════════
// Branch
// ═══════════════════════════════════════════════════════════════════

model Branch {
  id        String   @id @default(uuid())
  code      String?  @unique @db.VarChar(20)
  contact   String?  @db.VarChar(255)
  country   String?  @db.VarChar(100)
  city      String?  @db.VarChar(100)
  area      String?  @db.VarChar(100)
  address   String?  @db.VarChar(255)
  status    Status   @default(ACTIVE)
  users     User[]
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("branches")
}

// ═══════════════════════════════════════════════════════════════════
// User
// ═══════════════════════════════════════════════════════════════════

model User {
  id             String           @id @default(uuid())
  email          String           @unique @db.VarChar(255)
  password       String           @db.VarChar(255)
  firstName      String           @map("first_name") @db.VarChar(100)
  lastName       String?          @map("last_name") @db.VarChar(100)
  phone          String?          @unique @db.VarChar(20)
  profilePicture String?          @map("profile_picture") @db.VarChar(255)
  isVerified     Boolean          @default(true) @map("is_verified")
  lastLogin      DateTime?        @map("last_login")
  status         Status           @default(ACTIVE)
  role           Roles            @default(USER)
  gender         Gender?
  dateOfBirth    DateTime?        @map("date_of_birth")
  branchId       String?          @map("branch_id")
  branch         Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  permissions    UserPermission[]
  addresses      Address[]
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  @@index([email, status])
  @@index([firstName, lastName])
  @@map("users")
}

// ═══════════════════════════════════════════════════════════════════
// Per-user permissions (resource + dynamic actions) — set by super admin
// ═══════════════════════════════════════════════════════════════════

model UserPermission {
  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource String
  actions  String[] @default([])

  @@unique([userId, resource])
  @@map("user_permissions")
}

// Dynamic action catalog (the "attributes"): create/read/update/delete/export
// + any custom key the super admin creates.
model Action {
  id        String   @id @default(uuid())
  key       String   @unique
  label     String
  isBuiltIn Boolean  @default(false) @map("is_built_in")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("actions")
}

// ═══════════════════════════════════════════════════════════════════
// Address (user)
// ═══════════════════════════════════════════════════════════════════

model Address {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String?  @db.VarChar(100)
  address   String?  @db.VarChar(255)
  city      String?  @db.VarChar(100)
  country   String?  @db.VarChar(100)
  isDefault Boolean  @default(false) @map("is_default")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("addresses")
}
